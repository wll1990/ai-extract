# IM 桥服务配置（复制为 .env 后填写）
# 承载渠道：飞书（扫码 + WebSocket）、企业微信（自建应用回调）、钉钉（Stream 长连接）

# 桥 HTTP 监听端口
PORT=3010

# 与后端共享的 HMAC 密钥（必须与后端 app.im.bridge-token 一致）
IM_BRIDGE_TOKEN=dev-im-bridge-token

# 后端地址（含 context-path /api/v1）
BACKEND_URL=http://localhost:8080/api/v1

# 企业微信：在企微管理后台把「应用 → 接收消息」的回调 URL 配成
#   https://<你的公网域名>/wecom/callback
# 由反向代理（nginx/caddy/云 LB）转发到本服务 3010；企微只接受 80/443 公网地址。
# 钉钉不需要回调地址（Stream 模式主动连出）。
