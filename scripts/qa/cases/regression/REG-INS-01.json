        "as": "company_admin",
        "api": "GET /admin/insights/discoveries?status=active&page=1&size=5",
        "expect": {
          "status": 200,
          "json": { "data.page": 1, "data.size": 5 }
        }
      },
      {
        "as": "company_admin",
        "api": "GET /admin/insights/discoveries/candidates?insightIds=00000000-0000-0000-0000-000000000000",
        "expect": { "status": 200 }
      }
    ],
    "assertions": []
  }
]
