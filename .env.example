DEEPSEEK_API_KEY=your-deepseek-api-key-here
# 用户登录态已迁到 Redis 会话；JWT_SECRET 现在只用于注册邀请令牌
JWT_SECRET=ec86ce46-f6f3-4075-8114-7dad9bc3b08e
# 32 字节 Base64，生成：openssl rand -base64 32
PARTNER_AES_KEY=

# MCP Client：默认关闭；配置外部 MCP server 后设为 true
MCP_CLIENT_ENABLED=false

# 企业配置本地部署模型（Ollama / vLLM）时，允许的内网主机白名单（逗号分隔，可填域名后缀）。
# 留空表示禁止任何 http/私网模型端点，防止借企业 Key 探测内网。
# 例：AI_LOCAL_MODEL_HOSTS=llm.corp.local,10.0.8.21
AI_LOCAL_MODEL_HOSTS=

