# === API 地址配置 ===
#
# 同域部署（推荐）：相对路径，无 CORS 问题
#   - 开发环境: next.config.js rewrites 代理到 localhost:8080
#   - 生产环境: Nginx location /api/ { proxy_pass http://backend:8080/api/; }
NEXT_PUBLIC_API_BASE_URL=/api/v1
#
# 跨域部署（前后端不同服务器）：改为完整 URL
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1
# 并确保后端配置了 CORS

# AI 服务（独立部署）
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
