'use client';
import { LoadingSpinner } from '@/components/ui/LoadingSpinner';
import { PHASE_LABELS } from '@/lib/constants';
import { getToken } from '@/lib/storage';
import { API_BASE } from '@/lib/api/client';

import React, { useState, useEffect, useRef, useCallback } from 'react';
import { useParams, useRouter } from 'next/navigation';
import { PhaseProgressBar } from '@/components/chat/PhaseProgressBar';
import { MessageBubble } from '@/components/chat/MessageBubble';
import { VoiceInput } from '@/components/voice/VoiceInput';
import { ResumeModal } from '@/components/modals/ResumeModal';
import {
  getSession,
  getMessages,
  sendMessage,
  resumeSession,
  pauseSession,
  restartSession,
  type InterviewMessageData,
  type InterviewSessionData,
} from '@/lib/api/interview';
import type { SseEvent } from '@/lib/sse';

/** 阶段映射 */
const PHASE_MAP = PHASE_LABELS;

/**
 * B3 AI访谈对话页
 *
 * AI萃取访谈的核心页面。包含四阶段进度条、对话区、输入区、
 * 中断恢复、暂停/重新开始等功能。
 */
export default function InterviewChatPage() {
  const params = useParams();
  const router = useRouter();
  const sessionId = params.sessionId as string;

  // 会话数据
  const [session, setSession] = useState<InterviewSessionData | null>(null);
  const [messages, setMessages] = useState<InterviewMessageData[]>([]);
  const [inputValue, setInputValue] = useState('');
  const [isLoading, setIsLoading] = useState(true);
  const [isStreaming, setIsStreaming] = useState(false);
  const [isCompleted, setIsCompleted] = useState(false);
  const [isOnline, setIsOnline] = useState(true);
  const [showResumeModal, setShowResumeModal] = useState(false);
  const [showMoreMenu, setShowMoreMenu] = useState(false);
  const [errorBanner, setErrorBanner] = useState<string | null>(null);
  const [suggestAdvance, setSuggestAdvance] = useState(false);
  const [showCompletionCard, setShowCompletionCard] = useState(false);
  const [completionReportId, setCompletionReportId] = useState<string | null>(null);
  const [showCollectPanel, setShowCollectPanel] = useState(true);

  // Refs
  const chatEndRef = useRef<HTMLDivElement>(null);
  const inputRef = useRef<HTMLTextAreaElement>(null);
  const abortRef = useRef<AbortController | null>(null);
  const streamingContentRef = useRef('');

  /**
   * 初始化：加载会话和消息
   */
  useEffect(() => {
    if (!sessionId) return;

    const init = async () => {
      try {
        const [sessionData, messagesData] = await Promise.all([
          getSession(sessionId),
          getMessages(sessionId),
        ]);

        setSession(sessionData);
        setMessages(messagesData);

        // 检查是否需要恢复
        if (sessionData.status === 'in_progress' || sessionData.status === 'paused') {
          // 最近一条是system消息说明是恢复场景
          const lastMsg = messagesData[messagesData.length - 1];
          if (lastMsg?.role === 'ai' && lastMsg.depth === -1) {
            // 引导消息，正常开场
          } else {
            setShowResumeModal(true);
          }
        }

        if (sessionData.status === 'completed') {
          setIsCompleted(true);
        }
      } catch (err) {
        console.error('加载会话失败:', err);
      } finally {
        setIsLoading(false);
      }
    };

    init();
  }, [sessionId]);

  /**
   * 监听网络状态
   */
  useEffect(() => {
    const handleOnline = () => {
      setIsOnline(true);
      setErrorBanner(null);
    };
    const handleOffline = () => {
      setIsOnline(false);
      setErrorBanner('网络连接已断开，请检查网络');
    };

    window.addEventListener('online', handleOnline);
    window.addEventListener('offline', handleOffline);
    return () => {
      window.removeEventListener('online', handleOnline);
      window.removeEventListener('offline', handleOffline);
    };
  }, []);

  /**
   * 滚动到底部
   */
  const scrollToBottom = useCallback(() => {
    chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, []);

  useEffect(() => {
    scrollToBottom();
  }, [messages, scrollToBottom]);

  /**
   * 发送消息
   */
  const handleSend = useCallback(async () => {
    const text = inputValue.trim();
    if (!text || isStreaming || isCompleted) return;

    // 添加用户消息到列表
    const userMsg: InterviewMessageData = {
      id: `temp-${Date.now()}`,
      role: 'user',
      content: text,
      depth: 0,
      phase: session?.currentPhase || 'opening',
      createdAt: new Date().toISOString(),
    };

    setMessages((prev) => [...prev, userMsg]);
    setInputValue('');
    setIsStreaming(true);
    streamingContentRef.current = '';

    // 添加临时AI消息占位
    const aiMsgId = `streaming-${Date.now()}`;
    const aiMsgPlaceholder: InterviewMessageData = {
      id: aiMsgId,
      role: 'ai',
      content: '',
      depth: 0,
      phase: session?.currentPhase || 'opening',
      createdAt: new Date().toISOString(),
    };
    setMessages((prev) => [...prev, aiMsgPlaceholder]);

    // 阶段快照
    let currentPhase = session?.currentPhase || 'opening';

    const controller = sendMessage(sessionId, text, {
      onChunk: (content) => {
        streamingContentRef.current += content;
        if (streamingContentRef.current.includes('【建议推进】')) {
          setSuggestAdvance(true);
        }
        setMessages((prev) =>
          prev.map((m) =>
            m.id === aiMsgId
              ? { ...m, content: streamingContentRef.current }
              : m,
          ),
        );
      },
      onPhaseChange: (phase) => {
        currentPhase = phase;
        setSession((prev) =>
          prev ? { ...prev, currentPhase: phase } : null,
        );
        // 插入转段分隔消息
        const dividerMsg: InterviewMessageData = {
          id: `phase-${phase}-${Date.now()}`,
          role: 'system',
          content: `―― ${PHASE_MAP[phase] || phase} ――`,
          depth: 0,
          phase,
          createdAt: new Date().toISOString(),
        };
        setMessages((prev) => [...prev, dividerMsg]);
      },
      onCollectUpdate: () => {
        getSession(sessionId).then(setSession).catch(() => {});
      },
      onDone: () => {
        setIsStreaming(false);
        getSession(sessionId).then((s) => {
          setSession(s);
          if (s.status === 'completed' && (s as any).reportId) {
            setIsCompleted(true);
            setCompletionReportId((s as any).reportId);
            setShowCompletionCard(true);
          }
        }).catch(console.error);
      },
      onError: (message) => {
        setIsStreaming(false);
        setErrorBanner(message);
        setMessages((prev) => prev.filter((m) => m.id !== aiMsgId));
      },
    });

    abortRef.current = controller;
  }, [inputValue, isStreaming, isCompleted, session, sessionId]);

  /**
   * 恢复访谈
   */
  const handleResume = useCallback(() => {
    setShowResumeModal(false);
    setIsStreaming(true);

    const controller = resumeSession(sessionId, {
      onChunk: (content) => {
        // 恢复场景不需要实时显示，等done后刷新
      },
      onDone: () => {
        setIsStreaming(false);
        // 重新加载消息
        getMessages(sessionId).then(setMessages).catch(console.error);
        getSession(sessionId).then(setSession).catch(console.error);
      },
      onError: (message) => {
        setIsStreaming(false);
        setErrorBanner(message);
      },
    });

    abortRef.current = controller;
  }, [sessionId]);

  /**
   * 重新开始
   */
  const handleRestart = useCallback(async () => {
    setShowResumeModal(false);
    try {
      await restartSession(sessionId);
      router.push('/interview/create');
    } catch (err) {
      console.error('重新开始失败:', err);
    }
  }, [sessionId, router]);

  /**
   * 用户主动标记当前阶段完成 → 调后端 /mark-phase-complete (SSE)
   * AI 做阶段小结 + 自然过渡，标记对应采集模块
   */
  const markPhaseComplete = useCallback(() => {
    const phase = session?.currentPhase || 'opening';
    const phaseLabel = PHASE_LABELS;

    // 内容预检：当前阶段用户消息数
    const userMsgs = messages.filter(m => m.role === 'user' && m.phase === phase);
    const minMsgs: Record<string,number> = {opening:0, storytelling:2, modeling:1, closing:1};
    const min = minMsgs[phase] || 0;
    if (userMsgs.length < min) {
      const tips: Record<string,string> = {
        opening: '还没开始聊呢，先说说你最难忘的一个客户案例吧。',
        storytelling: '故事还不太完整，再多聊几句细节——具体的话术、对方的反应、当时的感受。',
        modeling: '还没提炼出核心步骤，再想想：如果教给新人，第一步做什么？',
        closing: '还没聊适用的边界条件——什么情况下你这套方法行不通？'
      };
      alert(tips[phase] || '多聊几句效果更好，不着急推进。');
      return;
    }

    setIsStreaming(true);
    const controller = new AbortController();

    const token = getToken();
    fetch(`${API_BASE}/interviews/${sessionId}/mark-phase-complete`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ phase }),
      signal: controller.signal,
    }).then(async (response) => {
      if (!response.ok) { setIsStreaming(false); return; }
      const reader = response.body?.getReader();
      if (!reader) { setIsStreaming(false); return; }
      const decoder = new TextDecoder();
      let buffer = '';
      const aiMsgId = `transition-${Date.now()}`;
      const nextP = getNextPhase(phase);
      const isLastPhase = nextP === phase; // closing 完成后没有下一阶段
      const dividerPhase = isLastPhase ? 'completed' : nextP;
      const dividerLabel = isLastPhase ? '访谈完成' : (phaseLabel[nextP] || '');
      setMessages(prev => [...prev, { id: `phase-divider-${Date.now()}`, role: 'system', content: `―― ${dividerLabel} ――`, depth: 0, phase: dividerPhase, createdAt: new Date().toISOString() }]);
      setMessages(prev => [...prev, { id: aiMsgId, role: 'ai', content: '', depth: 0, phase: dividerPhase, createdAt: new Date().toISOString() }]);
      setSuggestAdvance(false);
      let fullContent = '';
      try {
        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          let idx: number;
          while ((idx = buffer.indexOf('\n\n')) !== -1) {
            const eventStr = buffer.substring(0, idx);
            buffer = buffer.substring(idx + 2);

            // 尝试多种 SSE 格式
            const lines = eventStr.split('\n').filter(l => l.trim());
            let jsonStr: string | null = null;
            for (const line of lines) {
              const trimmed = line.trim();
              if (trimmed.startsWith('data:')) {
                const afterData = trimmed.substring(5).trim();
                if (afterData.startsWith('{')) { jsonStr = afterData; break; }
              } else if (trimmed.startsWith('{')) {
                jsonStr = trimmed;
                break;
              }
            }

            if (jsonStr) {
              try {
                const event = JSON.parse(jsonStr);
                if (event.type === 'chunk' && event.content) {
                  fullContent += event.content;
                  setMessages(prev => prev.map(m => m.id === aiMsgId ? { ...m, content: fullContent } : m));
                } else if (event.type === 'phase_change') {
                  setSession(prev => prev ? { ...prev, currentPhase: event.content } : null);
                } else if (event.type === 'collect_update') {
                  getSession(sessionId).then(setSession).catch(()=>{});
                } else if (event.type === 'done' && event.reportId) {
                  setIsCompleted(true);
                  setCompletionReportId(event.reportId);
                  setShowCompletionCard(true);
                  getSession(sessionId).then(setSession).catch(()=>{});
                }
              } catch (parseErr) {
                console.warn('[markPhaseComplete SSE] JSON parse failed:', parseErr, 'raw:', jsonStr);
              }
            } else {
              console.warn('[markPhaseComplete SSE] No JSON in event:', eventStr);
            }
          }
        }
      } catch (err: any) {
        if (err.name !== 'AbortError') console.error(err);
      }
      setIsStreaming(false);
    }).catch(() => setIsStreaming(false));
    abortRef.current = controller;
  }, [session, sessionId, messages, router]);

  const getNextPhase = (cur: string) => {
    const order = ['opening', 'storytelling', 'modeling', 'closing'];
    const idx = order.indexOf(cur);
    return idx >= 0 && idx < order.length - 1 ? order[idx + 1] : cur;
  };

  // 从会话数据中读取访谈类型
  const interviewType = (session as any)?.interviewType || 'sales';

  const getPhaseButtonLabel = (cur: string) => {
    const salesLabels: Record<string,string> = {
      opening: '我开始讲了 →',
      storytelling: '故事讲完了，提炼方法 →',
      modeling: '步骤清楚了，说说边界 →',
      closing: '都聊完了，生成报告 ✓',
    };
    const expertLabels: Record<string,string> = {
      opening: '我想好案例了 →',
      storytelling: '这段经历讲完了，继续 →',
      modeling: '框架清楚了，说说边界 →',
      closing: '都聊完了，生成报告 ✓',
    };
    const labels = interviewType === 'expert' ? expertLabels : salesLabels;
    return labels[cur] || '继续 →';
  };

  /**
   * 暂停访谈
   */
  const handlePause = useCallback(async () => {
    try {
      await pauseSession(sessionId);
      router.push('/interview/create');
    } catch (err) {
      console.error('暂停失败:', err);
    }
  }, [sessionId, router]);

  /**
   * 语音转录回调
   */
  const handleTranscription = useCallback((text: string) => {
    setInputValue((prev) => prev + text);
  }, []);

  /**
   * 键盘事件
   */
  const handleKeyDown = useCallback(
    (e: React.KeyboardEvent) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        handleSend();
      }
    },
    [handleSend],
  );

  // 加载中
  if (isLoading) {
    return (
      <div className="flex min-h-screen items-center justify-center bg-surface">
        <div className="flex flex-col items-center gap-4">
          <LoadingSpinner fullScreen={false} />
          <span className="text-sm text-muted-foreground">加载访谈中...</span>
        </div>
      </div>
    );
  }

  return (
    <div className="flex min-h-screen flex-col bg-surface">
      {/* 网络中断提示条 */}
      {!isOnline && (
        <div className="flex items-center justify-center bg-warning-bg py-2 text-sm text-warning">
          <svg className="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
            <path strokeLinecap="round" strokeLinejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126z" />
          </svg>
          网络连接已断开
        </div>
      )}

      {/* 错误提示条 */}
      {errorBanner && (
        <div className="flex items-center justify-between bg-danger-bg px-6 py-2 text-sm text-danger">
          <span>{errorBanner}</span>
          <button
            type="button"
            onClick={() => setErrorBanner(null)}
            className="ml-4 text-muted-foreground-2 hover:text-muted-foreground"
          >
            ✕
          </button>
        </div>
      )}

      {/* 顶部进度条 + 更多菜单 */}
      <div className="sticky top-0 z-30 border-b border-border bg-surface-2/95 backdrop-blur-sm">
        <div className="flex items-center justify-between px-6">
          <PhaseProgressBar
            phases={
              session?.phases || [
                { name: 'opening', label: '开场定调', status: 'current' as const },
                { name: 'storytelling', label: '故事深描', status: 'pending' as const },
                { name: 'modeling', label: '模型提炼', status: 'pending' as const },
                { name: 'closing', label: '收网确认', status: 'pending' as const },
              ]
            }
          />

          <div className="flex items-center gap-2">
            {/* 暂停按钮 */}
            {!isCompleted && (
              <button
                type="button"
                onClick={handlePause}
                disabled={isStreaming}
                className="rounded-lg p-2 text-muted-foreground hover:text-foreground hover:bg-primary-light/30 disabled:opacity-40 transition-colors"
                title="暂停访谈"
              >
                ⏸
              </button>
            )}

            {/* 引导式推进按钮 */}
            {!isCompleted && (
              <button
                type="button"
                onClick={markPhaseComplete}
                disabled={isStreaming}
                className={`rounded-lg px-4 py-2 text-sm font-medium transition-all disabled:opacity-40 ${
                  suggestAdvance
                    ? 'bg-primary text-white animate-pulse ring-2 ring-amber-400 ring-offset-1'
                    : 'bg-primary/10 text-primary hover:bg-primary/20'
                }`}
              >
                {getPhaseButtonLabel(session?.currentPhase || 'opening')}
              </button>
            )}

            {/* 更多菜单 — 只保留重新开始 */}
            <div className="relative">
              <button
                type="button"
                onClick={() => setShowMoreMenu(!showMoreMenu)}
                className="rounded-lg p-2 text-muted-foreground transition-colors hover:bg-primary-light/30"
              >
                <svg className="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5}>
                  <path strokeLinecap="round" strokeLinejoin="round" d="M12 5v.01M12 12v.01M12 19v.01" />
                </svg>
              </button>

              {showMoreMenu && (
                <div className="absolute right-0 top-full mt-1 w-36 rounded-lg border border-border bg-surface-2 py-1 shadow-lg">
                  <button
                    type="button"
                    onClick={() => { setShowMoreMenu(false); handleRestart(); }}
                    className="flex w-full items-center gap-2 px-4 py-2 text-sm text-danger transition-colors hover:bg-danger-bg"
                  >
                    重新开始
                  </button>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>

      {/* 对话区 + 采集面板 */}
      <div className="flex flex-1 overflow-hidden">
        {/* 对话区 */}
        <div className="flex-1 overflow-y-auto px-6 py-6">
          <div className="mx-auto max-w-[720px] space-y-4">
            {/* 主题标题 */}
            {session?.topic && (
              <h1 className="mb-6 text-center text-xl font-bold text-foreground">
                {session.topic}
              </h1>
            )}

            {/* 消息列表 */}
            {messages.map((msg, index) => {
              // 系统消息 → 转段分隔线
              if (msg.role === 'system' && msg.content.startsWith('――')) {
                return (
                  <div key={msg.id} className="flex items-center gap-4 py-2">
                    <div className="flex-1 border-t border-border" />
                    <span className={`text-sm font-medium ${msg.phase === 'completed' ? 'text-success' : 'text-primary'}`}>
                      {msg.content.replace(/――/g, '').trim()}
                    </span>
                    <div className="flex-1 border-t border-border" />
                  </div>
                );
              }

              // 系统消息
              if (msg.role === 'system') {
                return (
                  <div key={msg.id} className="my-4 rounded-lg bg-primary-light/20 py-2 text-center text-xs text-muted-foreground">
                    {msg.content}
                  </div>
                );
              }

              // 检查是否为阶段第一条AI消息（引导卡样式）
              const isFirstAiInPhase = msg.role === 'ai' && msg.depth === 0 && msg.phase !== 'completed' &&
                !messages.slice(0, index).some(m => m.role === 'ai' && m.phase === msg.phase);

              // 检测【建议推进】标记
              const advanceIdx = msg.content.indexOf('【建议推进】');
              const hasAdvance = advanceIdx !== -1;

              return (
                <div key={msg.id}>
                  {isFirstAiInPhase && msg.phase ? (
                    /* 阶段引导卡 */
                    <div className="rounded-2xl border-l-[3px] border-primary bg-warning-bg/30 px-5 py-4 shadow-sm">
                      <div className="flex items-center gap-2 mb-2">
                        <span className="text-sm">🎯</span>
                        <span className="text-xs font-medium text-primary">
                          {PHASE_MAP[msg.phase] || msg.phase}
                        </span>
                      </div>
                      <div className="text-sm text-foreground whitespace-pre-wrap break-words">
                        {hasAdvance
                          ? msg.content.substring(0, advanceIdx).trim()
                          : msg.content}
                      </div>
                    </div>
                  ) : (
                    /* 普通消息气泡 */
                    <MessageBubble
                      role={msg.role}
                      content={hasAdvance ? msg.content.substring(0, advanceIdx).trim() : msg.content}
                      depth={msg.depth}
                      phase={msg.phase}
                      createdAt={msg.createdAt}
                      isNew={msg.id.startsWith('temp') || msg.id.startsWith('streaming') || msg.id.startsWith('transition')}
                    />
                  )}
                </div>
              );
            })}

            {/* 完成卡片 */}
            {showCompletionCard && (
              <div className="mt-6 rounded-2xl bg-surface-2 p-8 shadow-lg">
                <div className="text-center">
                  <span className="text-5xl">🎉</span>
                  <h3 className="mt-4 text-xl font-bold text-foreground">访谈完成！</h3>
                </div>
                {/* 采集成果 */}
                {session?.collectStatus && (
                  <div className="mt-6 grid grid-cols-2 gap-2">
                    {[
                      { key: 'caseStory', label: '案例故事' },
                      { key: 'steps', label: '核心步骤' },
                      { key: 'decision', label: '关键决策' },
                      { key: 'mindset', label: '专家心法' },
                      { key: 'boundary', label: '适用边界' },
                      { key: 'checklist', label: '行动清单' },
                    ].map(({ key, label }) => (
                      <div key={key} className="flex items-center gap-2 rounded-lg bg-success-bg px-3 py-2 text-sm">
                        <span>✅</span>
                        <span className="text-success">{label}</span>
                      </div>
                    ))}
                  </div>
                )}
                <p className="mt-4 text-sm text-muted-foreground text-center">
                  报告已生成，你的经验将被更多同事学习和使用
                </p>
                <div className="mt-6 flex justify-center gap-3">
                  {completionReportId && (
                    <button
                      type="button"
                      onClick={() => router.push(`/report/${completionReportId}/done`)}
                      className="rounded-lg bg-foreground px-6 py-2.5 text-sm text-white hover:bg-primary transition-colors"
                    >
                      查看萃取报告 →
                    </button>
                  )}
                </div>
              </div>
            )}

            {/* 旧的完成提示 — 保留兼容但不再自动跳转 */}
            {isCompleted && !showCompletionCard && (
              <div className="mt-6 rounded-2xl bg-surface-2 p-6 text-center shadow-lg">
                <div className="mb-3 text-4xl">🎉</div>
                <h3 className="mb-2 text-lg font-bold text-foreground">访谈完成！</h3>
                <p className="mb-4 text-sm text-muted-foreground">正在生成萃取报告...</p>
                <div className="mx-auto h-1 w-48 overflow-hidden rounded-full bg-border">
                  <div className="h-full w-full animate-[shimmer_3s_ease-in-out] bg-primary" />
                </div>
              </div>
            )}

            <div ref={chatEndRef} />
          </div>
        </div>

        {/* 右侧采集进度面板 */}
        {showCollectPanel && session?.collectStatus && (
          <div className="hidden lg:flex w-[260px] flex-shrink-0 flex-col border-l border-border bg-surface-2 overflow-y-auto">
            <div className="flex items-center justify-between px-4 py-3 border-b border-primary-light/30">
              <h3 className="text-sm font-semibold text-foreground">📋 萃取进度</h3>
              <button
                type="button"
                onClick={() => setShowCollectPanel(false)}
                className="text-xs text-muted-foreground-2 hover:text-muted-foreground"
              >
                收起
              </button>
            </div>
            <div className="flex-1 px-4 py-4 space-y-2">
              {[
                { key: 'caseStory', label: '案例故事', phase: 'storytelling' },
                { key: 'steps', label: '核心步骤模型', phase: 'modeling' },
                { key: 'decision', label: '关键决策点', phase: 'modeling' },
                { key: 'mindset', label: '专家心法', phase: 'modeling' },
                { key: 'boundary', label: '适用边界', phase: 'closing' },
                { key: 'checklist', label: '行动检查清单', phase: 'closing' },
              ].map(({ key, label, phase }) => {
                const isDone = (session.collectStatus as any)[key] === 'done';
                const isCurrentPhase = session.currentPhase === phase;
                return (
                  <div
                    key={key}
                    className={`flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition-colors ${
                      isDone ? 'bg-success-bg' : isCurrentPhase ? 'bg-warning-bg/30' : 'bg-surface'
                    }`}
                  >
                    <span className="text-base">
                      {isDone ? '✅' : isCurrentPhase ? '🔄' : '⬜'}
                    </span>
                    <div>
                      <p className={`font-medium ${isDone ? 'text-success' : isCurrentPhase ? 'text-warning' : 'text-muted-foreground-2'}`}>
                        {label}
                      </p>
                      <p className="text-xs text-muted-foreground-2">
                        {isDone ? '已采集' : isCurrentPhase ? '采集中...' : '待采集'}
                      </p>
                    </div>
                  </div>
                );
              })}
            </div>
            {/* 萃取风格指示器 */}
            <div className="border-t border-primary-light/30 px-4 py-3">
              <p className="text-xs text-muted-foreground-2 mb-1">🧠 萃取风格</p>
              <p className="text-sm font-medium text-foreground">
                {session.expertSkillUsed || '综合 · 基础版'}
              </p>
            </div>
          </div>
        )}

        {/* 窄屏折叠面板按钮 */}
        {!showCollectPanel && session?.collectStatus && (
          <button
            type="button"
            onClick={() => setShowCollectPanel(true)}
            className="absolute right-4 top-24 lg:hidden rounded-lg bg-surface-2 border border-border px-3 py-1.5 text-xs text-muted-foreground shadow-sm hover:text-foreground"
          >
            📋 进度
          </button>
        )}
      </div>

      {/* 底部输入区 */}
      {!isCompleted && (
        <div className="sticky bottom-0 border-t border-border bg-surface-2 px-6 py-4">
          <div className="mx-auto flex max-w-[720px] items-end gap-3">
            {/* 语音输入按钮 */}
            <VoiceInput
              onTranscription={handleTranscription}
              disabled={isStreaming}
            />

            {/* 输入框 */}
            <textarea
              ref={inputRef}
              value={inputValue}
              onChange={(e) => setInputValue(e.target.value)}
              onKeyDown={handleKeyDown}
              placeholder={
                session?.currentPhase === 'opening'
                  ? '输入你的案例故事...'
                  : session?.currentPhase === 'storytelling'
                    ? '继续讲述细节...'
                    : session?.currentPhase === 'modeling'
                      ? '总结你的核心步骤...'
                      : '说说适用边界...'
              }
              disabled={isStreaming}
              rows={1}
              className="flex-1 resize-none rounded-xl border border-border bg-surface-2 px-4 py-3 text-sm text-foreground placeholder-muted-foreground-2 outline-none transition-all focus:border-foreground focus:ring-1 focus:ring-foreground/20 disabled:opacity-50"
              style={{
                minHeight: '52px',
                maxHeight: '120px',
              }}
              onInput={(e) => {
                const target = e.target as HTMLTextAreaElement;
                target.style.height = 'auto';
                target.style.height = Math.min(target.scrollHeight, 120) + 'px';
              }}
            />

            {/* 发送按钮 */}
            <button
              type="button"
              onClick={handleSend}
              disabled={!inputValue.trim() || isStreaming}
              className="flex h-[52px] w-[52px] flex-shrink-0 items-center justify-center rounded-xl bg-foreground text-white transition-all hover:bg-primary disabled:cursor-not-allowed disabled:opacity-40"
            >
              {isStreaming ? (
                <div className="h-4 w-4 animate-spin rounded-full border-2 border-white/30 border-t-white" />
              ) : (
                <svg className="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
                  <path strokeLinecap="round" strokeLinejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                </svg>
              )}
            </button>
          </div>

          {/* 底部提示 */}
          <p className="mt-2 text-center text-xs text-muted-foreground-2">
            空格键长按录音
          </p>
        </div>
      )}

      {/* 恢复弹窗 */}
      {showResumeModal && session && (
        <ResumeModal
          open={showResumeModal}
          topic={session.topic}
          currentPhase={session.currentPhase}
          lastActiveAt={session.lastActiveAt}
          onResume={handleResume}
          onRestart={handleRestart}
          onClose={() => setShowResumeModal(false)}
        />
      )}
    </div>
  );
}
