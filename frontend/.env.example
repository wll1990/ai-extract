# 后端 API 地址
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# AI 服务地址
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# 销冠门户：分享卡片用的站点地址（决定链接贴到微信/飞书时缩略图和标题的绝对路径）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 销冠门户：预约区微信二维码
# 把二维码图片放到 frontend/public/assets/ 下，这里写成 /assets/wechat-qr.png
# 留空则门户不显示二维码卡片（不会渲染空的占位框）
NEXT_PUBLIC_DEMO_WECHAT_QR=
NEXT_PUBLIC_DEMO_WECHAT_ID=
